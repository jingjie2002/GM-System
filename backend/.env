# =================================================================
# GM-System 后端环境变量配置
# =================================================================

# 1. Django 核心配置
# 这是一个随机生成的密钥，用于加密 Session 和 Token，请妥善保管
SECRET_KEY=django-insecure-gm-system-$(date +%s)-key-2026
# 开发模式开启，可以看到详细报错
DEBUG=True

# 2. 数据库配置 (PostgreSQL)
# 数据库名称
DB_NAME=gm_system
# 数据库用户名（默认通常是 postgres）
DB_USER=postgres
# 数据库密码（已根据你的要求修改）
DB_PASSWORD=123456
# 数据库地址，本地开发通常是 localhost
DB_HOST=localhost
# PostgreSQL 默认端口
DB_PORT=5432

# 3. 跨域配置 (CORS)
# 留空表示允许所有来源访问（开发环境方便对接），生产环境需填写前端域名
CORS_ALLOWED_ORIGINS=

# 4. JWT 令牌配置 (可选覆盖)
# 如果需要调整 Token 有效期，可以取消下方注释
# ACCESS_TOKEN_LIFETIME_HOURS=24
# REFRESH_TOKEN_LIFETIME_DAYS=7