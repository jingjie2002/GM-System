# GM-System Backend Environment Configuration
# Copy this file to .env and fill in the values

# Django Core
SECRET_KEY=your-super-secret-key-here-change-in-production
DEBUG=True

# Database Configuration (PostgreSQL)
DB_NAME=gm_system
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
# Set to comma-separated domains in production, e.g. https://your-frontend.com
# Leave empty to allow all origins (development only)
CORS_ALLOWED_ORIGINS=

# JWT Configuration (optional overrides)
# ACCESS_TOKEN_LIFETIME_HOURS=24
# REFRESH_TOKEN_LIFETIME_DAYS=7
