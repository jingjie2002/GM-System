-            BulkInsertMapper.types.get(
-                getattr(field, "target_field", field).get_internal_type(), "%s"
-            )
-            for field in fields
-            if field
-        ]
-        query = []
-        for row in placeholder_rows:
-            select = []
-            for i, placeholder in enumerate(row):
-                # A model without any fields has fields=[None].
