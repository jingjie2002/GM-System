-def inlineformset_factory(
-    parent_model,
-    model,
-    form=ModelForm,
-    formset=BaseInlineFormSet,
-    fk_name=None,
-    fields=None,
-    exclude=None,
-    extra=3,
-    can_order=False,
-    can_delete=True,
-    max_num=None,
-    formfield_callback=None,
-    widgets=None,
-    validate_max=False,
-    localized_fields=None,
-    labels=None,
-    help_texts=None,
-    error_messages=None,
-    min_num=None,
-    validate_min=False,
-    field_classes=None,
-    absolute_max=None,
-    can_delete_extra=True,
-    renderer=None,
-    edit_only=False,
-):
-    """
-    Return an ``InlineFormSet`` for the given kwargs.
-
-    ``fk_name`` must be provided if ``model`` has more than one ``ForeignKey``
-    to ``parent_model``.
