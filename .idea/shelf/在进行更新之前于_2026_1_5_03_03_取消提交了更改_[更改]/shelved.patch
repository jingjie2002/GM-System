-        smin, smax, smean, sstd = c_double(), c_double(), c_double(), c_double()
-        stats_args = [
-            self._ptr,
-            c_int(approximate),
-            byref(smin),
-            byref(smax),
-            byref(smean),
-            byref(sstd),
-            c_void_p(),
-            c_void_p(),
