+++ /dev/null	(revision 2e710c0b17639b00ab1dedb4953d7f5c21c36a3c)
@@ -1,294 +0,0 @@
-"""Base option parser setup"""
-
-import logging
-import optparse
-import shutil
-import sys
-import textwrap
-from contextlib import suppress
-from typing import Any, Dict, Generator, List, Optional, Tuple
-
