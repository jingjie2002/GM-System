-                # fields from the model"
-                opts.fields = None
-
-            fields = fields_for_model(
-                opts.model,
-                opts.fields,
-                opts.exclude,
-                opts.widgets,
-                opts.formfield_callback,
-                opts.localized_fields,
-                opts.labels,
-                opts.help_texts,
-                opts.error_messages,
-                opts.field_classes,
