-    "%d.%m.%Y %H:%M:%S.%f",  # '25.10.2006 14:30:59.000200'
-    "%d.%m.%Y %H:%M",  # '25.10.2006 14:30'
-    "%d.%m.%y %H:%M:%S",  # '25.10.06 14:30:59'
-    "%d.%m.%y %H:%M:%S.%f",  # '25.10.06 14:30:59.000200'
-    "%d.%m.%y %H:%M",  # '25.10.06 14:30'
-]
