-        # file uploads in MultiPartParser.
-        content_type = meta.get('HTTP_CONTENT_TYPE',
-                                meta.get('CONTENT_TYPE', ''))
-        try:
-            content_length = int(meta.get('HTTP_CONTENT_LENGTH',
-                                          meta.get('CONTENT_LENGTH', 0)))
-        except (ValueError, TypeError):
-            content_length = None
-
